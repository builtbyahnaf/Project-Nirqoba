struct Block8 { int x0; int x1; int x2; int x3; int x4; int x5; int x6; int x7; }
int function main() {
    var n = 2000000;
    var blocks = n / 8;
    var a = memory.owned_array<Block8>(blocks);
    for (var i = 0; i < blocks; i += 1) {
        a[i].x0 = i; a[i].x1 = i; a[i].x2 = i; a[i].x3 = i;
        a[i].x4 = i; a[i].x5 = i; a[i].x6 = i; a[i].x7 = i;
    }
    var sum = 0;
    for (var r = 0; r < 200; r += 1) {
        for (var j = 0; j < blocks; j += 1) {
            sum += a[j].x0 + a[j].x1 + a[j].x2 + a[j].x3 + a[j].x4 + a[j].x5 + a[j].x6 + a[j].x7;
        }
    }
    print(sum);
    return 0;
}
