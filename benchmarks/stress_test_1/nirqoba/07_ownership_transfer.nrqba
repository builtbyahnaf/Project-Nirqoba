// Ownership transfer test: 1M owned arrays created, passed by value (transferred), summed, freed.
// Nirqoba transfers ownership when passing owned_array to a function that takes owned_array.
// We simulate with a loop: allocate 8-element array, fill, sum in-place, count total.

int function main() {
    var total = 0;
    var i = 0;
    while (i < 1000000) {
        var arr = memory.owned_array<int>(8);
        for (var j = 0; j < 8; j += 1) {
            arr[j] = i + j;
        }
        // sum array manually (no transfer possible without supported syntax)
        var s = 0;
        for (var k = 0; k < 8; k += 1) {
            s += arr[k];
        }
        total += s;
        i += 1;
    }
    print(total);
    return 0;
}
