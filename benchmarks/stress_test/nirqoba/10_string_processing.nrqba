int function main() {
    var size = 10000000;
    var buf = memory.owned_array<byte>(size);

    for (var i = 0; i < size; i += 1) {
        var mod = i % 40;
        if (mod == 39) {
            buf[i] = 32 as byte;
        } else {
            buf[i] = ((mod % 26) + 97) as byte;
        }
    }

    var words = 0;
    var vowels = 0;
    for (var j = 0; j < size; j += 1) {
        var b = buf[j];
        if (b == (32 as byte)) {
            words += 1;
        } else {
            if (b == (97 as byte) || b == (101 as byte) || b == (105 as byte) || b == (111 as byte) || b == (117 as byte)) {
                vowels += 1;
            }
        }
    }

    for (var k = 0; k < size; k += 1) {
        var ch = buf[k];
        if (ch >= (97 as byte) && ch <= (122 as byte)) {
            buf[k] = (((ch as int) - 97 + 13) % 26 + 97) as byte;
        }
    }

    var hash = 14695981039346656037;
    for (var m = 0; m < size; m += 1) {
        hash = (hash ^ (buf[m] as int)) * 1099511628211;
    }

    print(words);
    print(vowels);
    print(hash);
    return 0;
}
