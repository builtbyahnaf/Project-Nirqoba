// Mixed-size arena allocation: the same five size classes, reset every 512.
int function main() {
    let arena = memory.arena(65536);
    var sizes = [16, 32, 64, 128, 256];
    var iterations = 500000;
    var checksum = 0;
    var start = time.cycles();
    for (var batch = 0; batch < 977; batch += 1) {
        for (var index = 0; index < 512; index += 1) {
            var width = sizes[index % 5];
            var block = memory.allocate<byte>(width, arena);
            block[0] = (index % 251) as byte;
            block[width - 1] = ((index * 7) % 251) as byte;
            checksum += block[0] as int + block[width - 1] as int;
        }
        memory.arena_reset(arena);
    }
    var stop = time.cycles();
    memory.arena_destroy(arena);
    print(checksum);
    print(stop - start);
    return 0;
}
