// A shared payload may hold a shared pointer, which is what makes a cycle of them
// expressible: each node's field takes a count of the other.
struct Node {
    int value;
    shared ptr Node next;
}

int function main() {
    var a = memory.shared_allocate<Node>(16);
    var b = memory.shared_allocate<Node>(16);
    *a = Node { value: 1, next: nullptr };
    *b = Node { value: 2, next: nullptr };
    (*a).next = b;
    (*b).next = a;
    print(memory.shared_count(a));
    print(memory.shared_count(b));
    print((*(*a).next).value);
    memory.shared_release(a);
    memory.shared_release(b);
    return 0;
}
