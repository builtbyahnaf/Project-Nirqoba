// A payload the arena still refuses. `Name` holds a shared token, which is a
// reference count rather than storage: a chunk release cannot decrement it, and
// the classifier will not pretend a field-level teardown exists for a lifetime the
// type does not show. The allocation therefore keeps the collector, and the report
// is where that decision stays visible.
struct Name {
    shared ptr int slot;
}

Name* function make_name() {
    var name = memory.allocate<Name>(8);
    return name;
}

int function main() {
    var n = make_name();
    return 0;
}
