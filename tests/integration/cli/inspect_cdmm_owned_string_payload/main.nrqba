// A payload that holds a reference count is collector storage.
//
// `Name` holds a shared token, so the block's release has to decrement it: the
// payload's own drop does that, and the report names the escape that keeps the site
// out of a deterministic zone. The site is accepted rather than rejected, because
// the walk that frees the block also releases the counts its fields hold.
struct Name {
    shared ptr int slot;
}

Name* function make_name() {
    var name = memory.allocate<Name>(8);
    return name;
}

int function main() {
    var n = make_name();
    return 0;
}
