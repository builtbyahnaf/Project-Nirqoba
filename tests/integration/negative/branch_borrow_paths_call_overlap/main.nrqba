struct P {
    int x;
    int y;
    int z;
}

borrow mut source int* function writable(borrow mut int* source) {
    return source;
}

void function pair(borrow mut int* first, borrow mut int* second) { }

int function main() {
    var p = P { x: 1, y: 2, z: 3 };
    {
        let seed = &p.x;
    }
    @Nullable var ptr int view = nullptr;
    if (p.x == 1) {
        view = writable(&p.x);
    } else {
        view = writable(&p.y);
    }
    pair(writable(view), &p.x);
    return 0;
}
