struct P {
    int x;
    int y;
}

borrow mut source int* function inner(borrow mut int* source) {
    return source;
}

borrow mut source int* function outer(borrow mut int* source) {
    return inner(source);
}

borrow mut source int* function writable(borrow mut int* source) {
    return source;
}

int function main() {
    var p = P { x: 1, y: 2 };
    var first = outer(&p.x);
    var second = writable(&p.x);
    return *first + *second;
}
