borrow source array_view<int> function identity_view(borrow array_view<int> source) {
    return source;
}

int function main() {
    var values = memory.owned_array<int>(1);
    let view = memory.array_view<int>(values, 0, 1);
    let returned = identity_view(view);
    let moved = values;
    return returned[0] + moved[0];
}
