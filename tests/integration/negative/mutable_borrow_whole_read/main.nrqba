struct P {
    int x;
    int y;
}

borrow mut source int* function writable(borrow mut int* source) {
    return source;
}

int function read_p(P value) {
    return value.x;
}

int function main() {
    var p = P { x: 1, y: 2 };
    var view = writable(&p.x);
    print(read_p(p));
    return *view;
}
