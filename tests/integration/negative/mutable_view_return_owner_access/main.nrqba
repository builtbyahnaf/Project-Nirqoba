borrow mut source array_view<int> function tail(
    borrow mut array_view<int> source,
    int start
) {
    return memory.array_view_mut<int>(source, start, source.length - start);
}

int function main() {
    var owner = memory.owned_array<int>(4);
    var rest = tail(memory.array_view_mut<int>(owner, 0, owner.length), 1);
    print(owner[1]);
    return 0;
}
