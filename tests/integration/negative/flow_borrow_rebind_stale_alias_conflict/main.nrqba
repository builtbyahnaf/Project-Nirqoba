struct P { int x; int y; }

borrow mut source int* function writable(borrow mut int* source) {
    return source;
}

int function main() {
    var p = P { x: 1, y: 2 };
    { let seed = &p.x; }
    var view = writable(&p.x);
    var alias = view;
    view = writable(&p.y);
    var other = writable(&p.x);
    *other = 9;
    return 0;
}
