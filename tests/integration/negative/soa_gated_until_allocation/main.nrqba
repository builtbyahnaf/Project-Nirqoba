// `soa<T>` parses and types, but nothing may use it until a strided trace
// callback exists: allocating a reference column without one would let the
// collector free a reachable target. The compiler must refuse, not guess.
struct Point { int x; int y; }

int function width(soa<Point> ps) {
    return 0;
}

int function main() {
    print(0);
    return 0;
}
