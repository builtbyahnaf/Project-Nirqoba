// A parent with one field uninitialized cannot be copied as a whole.
struct Inner { shared ptr int data; int tag; }
struct Outer { Inner inner; int extra; }
int function main() {
    var o: Outer = uninit;
    o.inner.data = memory.shared_allocate<int>(1);
    o.inner.tag = 2;
    var p = o;
    return 0;
}
