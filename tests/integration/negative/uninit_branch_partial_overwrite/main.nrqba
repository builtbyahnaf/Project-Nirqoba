struct Inner { owned ptr int data; int tag; }
struct Outer { Inner inner; int extra; }

int function main() {
    var o: Outer = uninit;
    if (1 == 1) {
        o.inner.data = memory.allocate<int>(1);
        *o.inner.data = 7;
    } else {
        o.inner.tag = 1;
    }
    o.inner = Inner { data: memory.allocate<int>(1), tag: 2 };
    return 0;
}
