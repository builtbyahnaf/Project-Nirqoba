struct P {
    int x;
    int y;
}

borrow mut source int* function writable(borrow mut int* source) {
    return source;
}

int function main() {
    var p = P { x: 1, y: 2 };
    {
        var first = writable(&p.x);
        *first = 4;
    }
    var second = writable(&p.x);
    *second = 9;
    print(*second);
    return 0;
}
