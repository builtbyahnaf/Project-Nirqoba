int function main() {
    defer print(1);
    var captured = 5;
    defer print(captured);
    captured = 6;
    {
        defer print(2);
        defer print(3);
    }

    var iteration = 0;
    while (iteration < 2) {
        defer print(4);
        iteration += 1;
        if (iteration == 1) {
            continue;
        }
        break;
    }

    var buffer = memory.allocate<byte>(8);
    defer memory.deallocate(buffer);
    buffer = memory.allocate<byte>(8);
    defer memory.deallocate(buffer);
    return 42;
}
