int function scaled_sum(int count) {
    var values = array.allocate<int>(count);
    var i = 0;
    while (i < count) {
        values[i] = i;
        i += 1;
    }
    var total = 0;
    i = 0;
    while (i < count) {
        total = total + values[i] * (count * 7 + 5);
        i += 1;
    }
    return total;
}

int function main(string[] args) {
    print(scaled_sum(args.length + 10));
    return 0;
}
