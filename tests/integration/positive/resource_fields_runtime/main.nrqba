// Every linked resource domain releases its field exactly once at scope exit.
struct Resources {
    owned file ptr byte file_handle;
    owned mutex ptr byte lock_handle;
    owned mapping ptr byte mapping_handle;
    owned secure ptr byte secret;
}

int function main() {
    let path = "tests/integration/positive/hello/expect.json";
    var resources = Resources {
        file_handle: file.open(path, false),
        lock_handle: mutex.create(),
        mapping_handle: memory.map_file(path, false),
        secret: memory.secure_allocate<byte>(16)
    };
    memory.secure_zero(resources.secret, 16);
    print("resource runtime fields");
    return 0;
}
