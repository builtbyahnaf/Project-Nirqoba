module dogfood;

// Recursive `owned ptr`: the type names itself, and `sizeof` still has to produce
// a finite size for it, which is the pointer plus the payload.
struct Tail {
    i64 value;
    owned ptr Tail next;
}

// The buffer element: plain data, so a caller can allocate a run of them and
// release the whole run with one deallocation.
struct Node {
    i64 value;
    i64 weight;
}

private int function scale(int value) {
    return value * 3;
}

public int function node_bytes() {
    return sizeof(Node);
}

public int function tail_bytes() {
    return sizeof(Tail);
}

public int function triple(int value) {
    return scale(value);
}

public string function describe(int kind) {
    if (kind == 1) {
        return "one";
    }
    return "many";
}

// A failure that crosses the module boundary: the caller propagates it with `?`
// and its own deferred cleanup still runs.
public Result<int, string> function triple_checked(int value) {
    if (value < 0) {
        return result.err("negative input");
    }
    return result.ok(scale(value));
}

public int function classify(int value) {
    var kind = 2;
    switch (value) {
        case 0: {
            kind = 0;
        }
        case 3: {
            kind = 1;
        }
        default: {
            kind = 2;
        }
    }
    return kind;
}
