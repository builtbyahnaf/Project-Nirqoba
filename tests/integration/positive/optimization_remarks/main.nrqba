// A fixed-size transform plus reduction: LLVM's loop vectorizer must report a
// vectorized loop for both, which is what `--remarks=loop-vectorize` surfaces.
int function main() {
    var values = memory.owned_array<int>(64);
    var i = 0;
    while (i < 64) {
        values[i] = i * 3;
        i += 1;
    }
    var total = 0;
    var j = 0;
    while (j < 64) {
        total += values[j];
        j += 1;
    }
    print(total);
    return 0;
}
