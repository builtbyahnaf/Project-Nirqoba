// Two allocation sites in one loop body are two allocations.
//
// Both are small and bounded, so both are promoted to stack slots; the answers
// only add up to 48 if each site has its own slot and each iteration rewrites it.
struct Pair {
    int a;
    int b;
}

int function main() {
    var total = 0;
    var i = 0;
    while (i < 4) {
        var p = memory.allocate<Pair>(16);
        var q = memory.allocate<Pair>(16);
        p[0].a = i;
        p[0].b = i + 1;
        q[0].a = i + 2;
        q[0].b = i + 3;
        total = total + p[0].a + p[0].b + q[0].a + q[0].b;
        i = i + 1;
    }
    print(total);
    return 0;
}
