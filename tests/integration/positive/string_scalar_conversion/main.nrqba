// Formatting and parsing between the scalar types and text. The constructors
// return owned buffers, so the live count after the block of them is zero once
// each binding's scope has ended; the parsers are total and answer 0 for text that
// holds no number, which is the only answer that cannot strand a caller.
int function main() {
    print(string.from_int(-42));
    print(string.from_float(2.5));
    print(string.to_int("1234"));
    print(string.to_int("   -7"));
    print(string.to_int("no digits"));
    print(string.to_float("1.5"));
    print(string.to_float("junk"));
    print(string.slice("abcdef", 1, 4));
    print(string.slice("abcdef", 4, 99));
    print(string.slice("abc", 2, 1));
    print(string.to_int(string.from_int(99)));
    return 0;
}
