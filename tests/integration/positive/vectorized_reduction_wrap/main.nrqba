// Fixed-width integer addition wraps, and a vectorized reduction must produce
// the same wrapped total as the scalar loop. Summing (i64::MAX - i) for i in
// [0, 8) wraps to -36.
int function main(string[] args) {
    var n = 5 + args.length;
    var values = memory.owned_array<int>(8);
    var i = 0;
    while (i < 8) {
        values[i] = 9223372036854775807 - i;
        i += 1;
    }
    var sum = 0;
    var j = 0;
    while (j < n) {
        sum += values[j];
        j += 1;
    }
    print(sum);
    return 0;
}
