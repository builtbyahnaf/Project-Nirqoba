// A completed owned nested aggregate moves as a whole.
struct Inner { owned ptr int data; int tag; }
struct Outer { Inner inner; int extra; }
int function main() {
    var o: Outer = uninit;
    o.inner.data = memory.allocate<int>(1);
    *o.inner.data = 7;
    o.inner.tag = 3;
    o.extra = 1;
    var moved: Inner = o.inner;
    print(*moved.data + moved.tag + o.extra);
    return 0;
}
