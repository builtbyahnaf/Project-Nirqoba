struct P { int x; int y; }
struct Doc { borrow mut ptr int value; }

borrow mut source int* function writable(borrow mut int* source) {
    return source;
}

int function main() {
    var p = P { x: 1, y: 2 };
    var d = Doc { value: &p.x };
    var y = writable(&p.y);
    *y = 9;
    d.value[0] = 7;
    print(*y);
    return 0;
}
