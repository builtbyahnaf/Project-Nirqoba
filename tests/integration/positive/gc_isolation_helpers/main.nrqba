// A GC-independent call chain: stack values, an ordinary heap buffer, a loop
// and a helper call. None of these operations may enter the collector merely
// because the runtime library is available.
int function add_one(int value) {
    var bytes = (memory.cpu_count() * (4 as i32)) as int;
    var buffer = memory.allocate<int>(bytes);
    *buffer = value + 1;
    let result = *buffer;
    memory.deallocate(buffer);
    return result;
}

int function main() {
    var total = 0;
    var index = 0;
    while (index < 3) {
        total = add_one(total);
        index = index + 1;
    }
    return total + 39;
}
