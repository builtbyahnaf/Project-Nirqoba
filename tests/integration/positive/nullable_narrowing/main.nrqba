// A nullable pointer is dereferenced only inside a branch that proves it non-null.
int function main() {
    var s: int = 11;
    @Nullable var ptr int p = &s;
    if (p is not nullptr) {
        print(*p);
    } else {
        print(-1);
    }
    @Nullable var ptr int q = nullptr;
    if (q is nullptr) {
        print(0);
    } else {
        print(*q);
    }
    if (q is nullptr) {
        print(2);
    }
    return 0;
}
