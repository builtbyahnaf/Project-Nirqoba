owned_array<int> function make_values() {
    var values = memory.owned_array<int>(3);
    values[0] = 12;
    values[1] = 34;
    values[2] = 56;
    return values;
}

int function consume(owned_array<int> values) {
    return values[0] + values[1] + values[2];
}

int function main() {
    var values = make_values();
    if (values.length != 3) {
        return 1;
    }
    return consume(values);
}
