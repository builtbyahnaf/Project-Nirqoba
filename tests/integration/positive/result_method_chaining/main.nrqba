// A `Result` is a value, so the call that produced it can be inspected directly.
// Naming a value only to read it once is not required any more:
//
//   divide(10, 2).unwrap()      the payload of what the call just returned
//   divide(10, 0).is_err()      whether that call failed
//
// `?` works the same way on a binding: `outcome?` propagates the Result the
// program stored, so an early return needs no temporary call site.
Result<int, string> function divide(int a, int b) {
    if (b == 0) {
        return result.err("division by zero");
    }
    return result.ok(a / b);
}

Result<int, string> function doubled(int a, int b) {
    var outcome = divide(a, b);
    var quotient = outcome?;
    return result.ok(quotient * 2);
}

int function main() {
    print(divide(10, 2).unwrap());
    print(divide(10, 2).is_ok());
    print(divide(10, 0).is_err());
    print(divide(10, 0).unwrap_err());

    print(doubled(9, 3).unwrap());

    var failed = doubled(1, 0);
    print(failed.is_err());
    print(failed.unwrap_err());
    return 0;
}
