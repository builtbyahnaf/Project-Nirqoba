owned_array<int> function make_values() {
    var values = memory.owned_array<int>(2);
    values[0] = 9;
    values[1] = 4;
    return values;
}

int function main() {
    var values = make_values();
    {
        let view = memory.array_view<int>(values, 0, 2);
        print(view[0] + view[1]);
    }
    return 0;
}
