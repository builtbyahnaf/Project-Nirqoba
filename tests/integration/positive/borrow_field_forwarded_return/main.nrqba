struct P {
    int x;
    int y;
}

borrow source int* function alias(borrow int* source) {
    return source;
}

borrow source int* function forward(borrow int* source) {
    return alias(source);
}

int function main() {
    var p = P { x: 7, y: 1 };
    let x = forward(&p.x);
    p.y = 2;
    return *x + p.y;
}
