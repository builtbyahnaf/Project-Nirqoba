int function main() {
    let first = make_shared();
    print(memory.shared_count(first));
    let second = memory.shared_retain(first);
    print(memory.shared_count(first));
    memory.shared_release(first);
    consume(second);
    return 0;
}

void function consume(shared byte* reference) {
    print(memory.shared_count(reference));
    memory.shared_release(reference);
}

shared byte* function make_shared() {
    return memory.shared_allocate<byte>(8);
}
