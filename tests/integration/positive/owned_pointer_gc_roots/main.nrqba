// Explicitly owned storage is outside the collector heap, but a managed field
// inside it still has to be traced. The returned child is reachable only through
// the owned pointer; without a typed root registration the collector reclaims it.
struct Node {
    int value;
    managed<Node> child;
}

managed<Node> function make_child() {
    var child = array.allocate<Node>(1);
    child[0].value = 73;
    return child;
}

int function main() {
    var bytes = (memory.cpu_count() * (64 as i32)) as int;
    var holder = memory.allocate<Node>(bytes);
    (*holder).child = make_child();
    gc.collect();
    gc.collect();
    var stats = gc.get_statistics();
    print(stats.live_objects);
    print((*holder).child[0].value);
    return 0;
}
