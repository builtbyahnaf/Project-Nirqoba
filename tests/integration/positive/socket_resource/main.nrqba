owned socket byte* function connect_stream() {
    return socket.connect("127.0.0.1", 7);
}

int function main() {
    var stream = connect_stream();
    var buffer = memory.allocate<byte>(64);
    socket.send(stream, "ping");
    socket.receive(stream, buffer, 64);
    defer socket.close(stream);
    memory.deallocate(buffer);
    return 0;
}
