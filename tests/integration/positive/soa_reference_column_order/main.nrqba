// The reference column is not the first column, and each row's scalar sits where a
// row-interleaved walk would look for a pointer. Reading this layout as an array of
// structs would visit tag values as references and miss the real ones, so retaining
// both nodes here is evidence the walk is column-strided.
struct Node {
    int value;
}

struct Row {
    int tag;
    managed<Node> node;
}

int function main() {
    var rows = memory.owned_soa<Row>(4);

    var left = array.allocate<Node>(1);
    left[0].value = 71;
    var right = array.allocate<Node>(1);
    right[0].value = 72;

    rows[0].tag = 7;
    rows[1].tag = 8;
    rows[2].tag = 9;
    rows[3].tag = 10;
    rows[2].node = left;
    rows[3].node = right;

    gc.collect();
    gc.collect();

    print(rows[2].tag);
    print(rows[3].tag);
    print(rows[2].node[0].value);
    print(rows[3].node[0].value);
    return 0;
}
