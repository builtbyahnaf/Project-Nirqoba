// Reallocation may move the owned block. The old address must stop being a
// root and the replacement must be registered before the next collection.
struct Node {
    int value;
    managed<Node> child;
}

managed<Node> function make_child() {
    var child = array.allocate<Node>(1);
    child[0].value = 73;
    return child;
}

int function main() {
    var bytes = (memory.cpu_count() * (64 as i32)) as int;
    var holder = memory.allocate<Node>(bytes);
    (*holder).child = make_child();
    holder = memory.reallocate<Node>(holder, bytes * 2);
    gc.collect();
    gc.collect();
    var stats = gc.get_statistics();
    print(stats.live_objects);
    print((*holder).child[0].value);
    return 0;
}
