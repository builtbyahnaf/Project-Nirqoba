// `unused_helper` is called from nowhere. Once the helpers stop looking
// externally visible, LLVM's dead-function elimination can delete it instead of
// emitting it into the object file.
int function unused_helper(int value) {
    return value * 7;
}

int function used_helper(int value) {
    return value + 1;
}

int function main() {
    print(used_helper(41));
    return 0;
}
