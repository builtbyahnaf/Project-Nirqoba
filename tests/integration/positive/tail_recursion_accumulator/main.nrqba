// The recursive call is the whole returned expression, so the recursion is a
// loop: at -O2 LLVM turns it into a `tailrecurse` cycle and the run must print
// the exact arithmetic sum, not a stack-overflow crash.
int function sum_tail(int n, int acc) {
    if (n == 0) {
        return acc;
    }
    return sum_tail(n - 1, acc + n);
}

int function main(string[] args) {
    print(sum_tail(250000 + args.length, 0));
    return 0;
}
