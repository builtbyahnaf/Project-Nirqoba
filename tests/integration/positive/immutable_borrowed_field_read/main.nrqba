struct Doc { borrow ptr int read_value; borrow mut ptr int write_value; }

int function main() {
    var read_owner = 5;
    var write_owner = 6;
    var d = Doc { read_value: &read_owner, write_value: &write_owner };
    d.write_value[0] = 9;
    print(d.read_value[0] + d.write_value[0]);
    return 0;
}
