int function sum_owned(int count) {
    var values = memory.owned_array<int>(count);
    var i = 0;
    while (i < count) {
        values[i] = i * 5;
        i += 1;
    }
    var total = 0;
    i = 0;
    while (i < count) {
        total = total + values[i];
        i += 1;
    }
    return total;
}

int function main(string[] args) {
    print(sum_owned(args.length + 7));
    return 0;
}
