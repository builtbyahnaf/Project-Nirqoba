void function set_first(borrow mut array_view<int> values) {
    values[0] = 31;
}

int function main() {
    var values = memory.owned_array<int>(2);
    {
        var view = memory.array_view_mut<int>(values, 0, 2);
        set_first(view);
        view[1] = 11;
    }
    return values[0] + values[1];
}
