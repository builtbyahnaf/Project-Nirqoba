// A nested aggregate completed field by field can be copied as a whole.
struct Inner { shared ptr int data; int tag; }
struct Outer { Inner inner; int extra; }
int function main() {
    var o: Outer = uninit;
    o.inner.data = memory.shared_allocate<int>(1);
    *o.inner.data = 4;
    o.inner.tag = 3;
    o.extra = 1;
    var copy: Inner = o.inner;
    print(memory.shared_count(copy.data));
    print(*copy.data + copy.tag + o.extra);
    return 0;
}
