struct Node {
    int value;
}

struct Pair {
    managed<Node> first;
    managed<Node> second;
}

int function combine(int seed) {
    var left = array.allocate<Node>(1);
    var right = array.allocate<Node>(1);
    left[0].value = seed;
    right[0].value = seed * 2;
    var pair = Pair { first: left, second: right };
    gc.collect();
    return pair.first[0].value + pair.second[0].value;
}

int function main() {
    print(combine(7));
    return 0;
}
