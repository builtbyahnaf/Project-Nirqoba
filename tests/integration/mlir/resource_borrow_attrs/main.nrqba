i64 function send_text(borrow socket byte* handle, string content) {
    return socket.send(handle, content);
}

owned socket byte* function open_stream(string host, int port) {
    return socket.connect(host, port);
}

owned socket byte* function forward_stream(owned socket byte* stream) {
    return stream;
}

void function drop_stream(owned socket byte* stream) { }

int function main() {
    var stream = forward_stream(open_stream("127.0.0.1", 7));
    send_text(stream, "text");
    drop_stream(stream);
    return 0;
}
