struct Item {
    string name;
    int count;
    f64 price;
}

int function sum_array(int[5] values) {
    var total = 0;
    for (var i = 0; i < 5; i += 1) {
        total += values[i];
    }
    return total;
}

int function main() {
    let s: string = "abc";
    print(s.length);
    let ch = s[1];
    print(ch);
    print(ch as int);
    var items: Item[3] = [Item {"a", 2, 1.5}, Item {"b", 3, 2.25}, Item {"c", 4, 0.5}];
    print(items[1].count);
    print(items[0].price);
    var nums: int[5] = [1, 2, 3, 4, 5];
    print(sum_array(nums));
    print(7 % 3);
    print(1.0 / 3.0);
    print(true);
    var m: int[2][2] = [[1, 2], [3, 4]];
    print(m[1][0]);
    print(m[0][1] + m[1][1]);
    return 0;
}
