// Insertion sort: array mutation, nested loops, swap through a temporary.
// Note: array arguments are passed by value, so the sort happens in `main`
// rather than in a helper (see docs/readiness.md, "aggregate arguments").
int function main() {
    var values: int[10] = [9, 4, 7, 1, 8, 2, 6, 3, 5, 0];
    var i = 1;
    while (i < 10) {
        let key = values[i];
        var j = i - 1;
        while (j >= 0 && values[j] > key) {
            values[j + 1] = values[j];
            j -= 1;
        }
        values[j + 1] = key;
        i += 1;
    }
    for (var i = 0; i < 10; i += 1) {
        print(values[i]);
    }
    return 0;
}
