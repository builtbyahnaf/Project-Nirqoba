// Matrix multiplication: multidimensional fixed arrays, nested loops.
int function main() {
    var a: int[2][3] = [[1, 2, 3], [4, 5, 6]];
    var b: int[3][2] = [[7, 8], [9, 10], [11, 12]];
    var c: int[2][2] = [[0, 0], [0, 0]];

    for (var row = 0; row < 2; row += 1) {
        for (var col = 0; col < 2; col += 1) {
            var sum = 0;
            for (var k = 0; k < 3; k += 1) {
                sum += a[row][k] * b[k][col];
            }
            c[row][col] = sum;
        }
    }

    print(c[0][0]);
    print(c[0][1]);
    print(c[1][0]);
    print(c[1][1]);
    return 0;
}
