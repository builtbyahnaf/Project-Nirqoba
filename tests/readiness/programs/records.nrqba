// Records: struct declaration, array of structs, field access, float totals.
struct Product {
    string name;
    int quantity;
    f64 unit_price;
}

f64 function line_total(Product item) {
    return (item.quantity as f64) * item.unit_price;
}

f64 function inventory_value(Product[4] items) {
    var total = 0.0;
    for (var i = 0; i < 4; i += 1) {
        total += line_total(items[i]);
    }
    return total;
}

int function main() {
    var items: Product[4] = [
        Product {"bolt", 100, 0.25},
        Product {"nut", 250, 0.10},
        Product {"washer", 40, 0.05},
        Product {"screw", 12, 1.50}
    ];
    print(items[0].name);
    print(items[1].quantity);
    print(line_total(items[3]));
    print(inventory_value(items));
    items[3].quantity = 20;
    print(inventory_value(items));
    return 0;
}
