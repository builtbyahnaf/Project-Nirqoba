// A tiny expression tokenizer: scanning a char buffer into numbers and
// operators. This is the kind of string work a beginner program needs.
bool function is_digit(char c) {
    return c >= '0' && c <= '9';
}

int function main() {
    var input: char[10] = ['1', '2', ' ', '+', ' ', '3', '4', ' ', '*', '2'];
    var numbers = 0;
    var operators = 0;
    var index = 0;
    while (index < 10) {
        let c = input[index];
        if (is_digit(c)) {
            var value = 0;
            while (index < 10 && is_digit(input[index])) {
                value = value * 10 + (input[index] as int - 48);
                index += 1;
            }
            numbers += 1;
            print(value);
        } else if (c == '+' || c == '-' || c == '*' || c == '/') {
            operators += 1;
            index += 1;
        } else {
            index += 1;
        }
    }
    print(numbers);
    print(operators);
    return 0;
}
